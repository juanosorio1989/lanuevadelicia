{
  "name": "lanuevadelicia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "vitest run tests/unit/data.test.ts",
    "build": "next build && next-image-export-optimizer",
    "test": "vitest run && TZ=Europe/London vitest run tests/unit/hours.test.ts",
    "e2e": "playwright test",
    "serve:out": "serve out -l 4173 -c ../serve.json",
    "serve:headers": "node scripts/serve-with-headers.mjs 4173",
    "check:out": "node scripts/check-out.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:ga": "node scripts/check-ga.mjs",
    "lhci": "lhci autorun",
    "lhci:simulate": "lhci autorun --config=lighthouserc.simulate.json",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:out && npm run check:links && npm run e2e",
    "lint": "eslint",
    "photos": "tsx scripts/import-photos.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.6",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-image-export-optimizer": "^1.21.2",
    "next-intl": "^4.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "serve": "^14.2.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
