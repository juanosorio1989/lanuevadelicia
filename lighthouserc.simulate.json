{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-with-headers.mjs 4173",
      "startServerReadyPattern": "serving out",
      "url": [
        "http://localhost:4173/es/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-simulate"
    }
  }
}
