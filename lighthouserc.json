{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-with-headers.mjs 4173",
      "startServerReadyPattern": "serving out",
      "url": [
        "http://localhost:4173/es/",
        "http://localhost:4173/es/menu/",
        "http://localhost:4173/en/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "throttlingMethod": "devtools",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:[0-9]+/(es/(menu/)?|en/)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-byte-weight": [
              "warn",
              {
                "maxNumericValue": 1600000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:[0-9]+/es/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 174080
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
